; Truckfire - Godot 4.7
; First playable prototype: road, imported Mercedes model and basic driving.
config_version=5

[application]

config/name="Truckfire"
run/main_scene="res://scenes/world/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

accelerate={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
brake={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
steer_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311)]}
steer_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
reverse={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
reset_vehicle={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
camera_toggle={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.42, 0.57, 0.68, 1)
textures/default_filters/use_nearest_mipmap_filter=false
